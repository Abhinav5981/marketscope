# Postgres connection used by Prisma (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://marketscope:marketscope@localhost:5433/marketscope?schema=public"

# Backend server port
PORT=4000

# Used as the contact string in the Nominatim User-Agent header, per Nominatim's usage policy
# (https://operations.osmfoundation.org/policies/nominatim/). Any working email is fine.
CONTACT_EMAIL="tabhit607@gmail.com"

# Frontend (Vite) — base URL of the backend API
VITE_API_BASE_URL="http://localhost:4000/api"
